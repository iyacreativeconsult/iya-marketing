rules_version = '2';

// Semua akses data melalui server Next.js (Firebase Admin SDK), yang
// menguatkuasakan peranan dan team dalam src/lib/server/.
// Browser tidak boleh baca atau tulis Firestore secara terus.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
